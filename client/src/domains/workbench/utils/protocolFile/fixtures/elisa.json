    },
    "pages": [
      {
        "id": "mqd21pe",
        "name": "Setup",
        "steps": [
          {
            "id": "5g6ltd4",
            "kind": "section",
            "text": "Coat"
          },
          {
            "id": "sj8vybv",
            "kind": "step",
            "level": 1,
            "text": "Make the coating mix.",
            "isMeanwhile": false
          },
          {
            "id": "wwkhgsb",
            "kind": "step",
            "level": 2,
            "text": "Dilute {Capture Ab} {Capture Ab dil.} in {Coating buffer}: {Capture Ab volume} into {Coating buffer volume}.",
            "isMeanwhile": false
          },
          {
            "id": "5cnnfzh",
            "kind": "step",
            "level": 2,
            "text": "Mix by inversion. Keep on ice.",
            "isMeanwhile": false
          },
          {
            "id": "z7gl596",
            "kind": "step",
            "level": 1,
            "text": "Add {Vol./well} per well to the {ELISA plate}. Seal and incubate overnight at 4 °C.",
            "isMeanwhile": false
          },
          {
            "id": "hdczedw",
            "kind": "section",
            "text": "Block"
          },
          {
            "id": "6xa33z4",
            "kind": "step",
            "level": 1,
            "text": "Wash 3× with 300 µL {Wash buffer} per well.",
            "isMeanwhile": false
          },
          {
            "id": "anchtd7",
            "kind": "step",
            "level": 1,
            "text": "Add 200 µL {Blocking buffer} per well. Incubate 1 h at room temperature.",
            "isMeanwhile": false
          },
          {
            "id": "x75xfnn",
            "kind": "step",
            "level": 1,
            "text": "Prepare the {IL-6 standard}: 2-fold series from {Top std}, {Std transfer} into {Std diluent}.",
            "isMeanwhile": true
          },
          {
            "id": "vz9482n",
            "kind": "section",
            "text": "Standards and samples"
          },
          {
            "id": "3w7rlio",
            "kind": "step",
            "level": 1,
            "text": "Wash 3× with 300 µL {Wash buffer} per well.",
            "isMeanwhile": false
          },
          {
            "id": "5y0cowk",
            "kind": "step",
            "level": 1,
            "text": "Add {Vol./well} of standards and samples per the plate map. Incubate 2 h at room temperature.",
            "isMeanwhile": false
          },
          {
            "id": "g2p74bd",
            "kind": "section",
            "text": "Detect"
          },
          {
            "id": "zt1fk5j",
            "kind": "step",
            "level": 1,
            "text": "Wash 3×, then add {Detection Ab} at {Detection Ab dil.}. Incubate 1 h at room temperature.",
            "isMeanwhile": false
          },
          {
            "id": "g40mt2b",
            "kind": "step",
            "level": 1,
            "text": "Wash 3×, then add {Streptavidin-HRP} at {Streptavidin-HRP dil.}. Incubate 20 min at room temperature, protected from light.",
            "isMeanwhile": false
          },
          {
            "id": "vbgdrr7",
            "kind": "step",
            "level": 1,
            "text": "Develop and read.",
            "isMeanwhile": false
          },
          {
            "id": "abww967",
            "kind": "step",
            "level": 2,
            "text": "Add 100 µL {TMB substrate} per well. Incubate 20 min, protected from light.",
            "isMeanwhile": false
          },
          {
            "id": "8bxdxw7",
            "kind": "step",
            "level": 2,
            "text": "Add 50 µL {Stop solution} per well.",
            "isMeanwhile": false
          },
          {
            "id": "16n157d",
            "kind": "step",
            "level": 2,
            "text": "Read at 450 nm on the {Plate reader} within 30 min.",
            "isMeanwhile": false
          }
        ]
      }
    ],
