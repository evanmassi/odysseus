    "pages": [
      {
        "id": "v2i5v7f",
        "name": "Setup",
        "steps": [
          {
            "id": "5fz1mwf",
            "kind": "section",
            "text": "Prepare cells"
          },
          {
            "id": "vmxtj81",
            "kind": "step",
            "level": 1,
            "text": "Warm {Complete DMEM} and {Trypsin-EDTA} to 37 °C for 15 min.",
            "isMeanwhile": false
          },
          {
            "id": "lw8cvkg",
            "kind": "step",
            "level": 1,
            "text": "Detach {HeLa}: rinse with {PBS}, add 2 mL {Trypsin-EDTA}, and incubate 3–5 min at 37 °C.",
            "isMeanwhile": false
          },
          {
            "id": "f93klwz",
            "kind": "step",
            "level": 2,
            "text": "Neutralize with 8 mL {Complete DMEM} and spin in the {Centrifuge}.",
            "isMeanwhile": false
          },
          {
            "id": "azg0ynh",
            "kind": "step",
            "level": 2,
            "text": "Resuspend and count. Live cells: {Live cell conc}.",
            "isMeanwhile": false
          },
          {
            "id": "i9v3m93",
            "kind": "section",
            "text": "Seed"
          },
          {
            "id": "k1yhcpf",
            "kind": "step",
            "level": 1,
            "text": "Mix {Cell suspension} of cells into {Media to add} {Complete DMEM}.",
            "isMeanwhile": false
          },
          {
            "id": "1rdyiis",
            "kind": "step",
            "level": 1,
            "text": "Seed {Vol./well} per well of the {Assay plate}: {Cells/well} per well.",
            "isMeanwhile": false
          },
          {
            "id": "rb01q8d",
            "kind": "step",
            "level": 2,
            "text": "Fill the outer wells with {Vol./well} {PBS}.",
            "isMeanwhile": false
          },
          {
            "id": "v9igc97",
            "kind": "step",
            "level": 1,
            "text": "Incubate overnight at 37 °C, 5% CO₂.",
            "isMeanwhile": false
          },
          {
            "id": "de3ye6p",
            "kind": "section",
            "text": "Treat"
          },
          {
            "id": "9sprfzj",
            "kind": "step",
            "level": 1,
            "text": "Make a 3-fold series of {Compound X} from {Top conc.}.",
            "isMeanwhile": false
          },
          {
            "id": "hmcc830",
            "kind": "step",
            "level": 1,
            "text": "Add compound per the plate map, vehicle to control wells. Incubate 72 h at 37 °C.",
            "isMeanwhile": false
          },
          {
            "id": "xthzyeb",
            "kind": "section",
            "text": "Read"
          },
          {
            "id": "e1tqrj5",
            "kind": "step",
            "level": 1,
            "text": "Bring the plate and {CellTiter-Glo} to room temperature for 30 min.",
            "isMeanwhile": false
          },
          {
            "id": "y0zwtv0",
            "kind": "step",
            "level": 1,
            "text": "Add 100 µL {CellTiter-Glo} per well, shake 2 min, then incubate 10 min at room temperature.",
            "isMeanwhile": false
          },
          {
            "id": "pmp9w3p",
            "kind": "step",
            "level": 1,
            "text": "Read luminescence on the {Plate reader}.",
            "isMeanwhile": false
          }
        ]
      }
    ],
