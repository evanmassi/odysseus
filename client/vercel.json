{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd .. && npm run build:shared && cd client && npm run build",
  "outputDirectory": "dist",
  "installCommand": "cd .. && npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api|socket\\.io).*)",
      "destination": "/index.html"
    }
  ]
}
