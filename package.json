{
  "name": "odysseus",
  "version": "1.0.0",
  "description": "Professional Liquid Nitrogen Tube Inventory Management System",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "build:shared": "npm --workspace @odysseus/shared-schemas run build",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "test": "npm run test:server && npm run test:client",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test",
    "lint": "npm run lint:client",
    "lint:fix": "npm run lint:client:fix",
    "lint:client": "cd client && npm run lint",
    "lint:client:fix": "cd client && npm run lint:fix",
    "format": "npm run format:client",
    "format:client": "cd client && npm run format",
    "typecheck": "npm run typecheck:client",
    "typecheck:client": "cd client && npm run typecheck",
    "clean": "rimraf server/dist client/dist",
    "prepare": "husky"
  },
  "workspaces": [
    "packages/*",
    "server",
    "client"
  ],
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.7",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "overlayscrollbars": "^2.14.0",
    "overlayscrollbars-react": "^0.5.6",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.1.5"
  },
  "overrides": {
    "file-stream-rotator": "1.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "rimraf": "^6.1.0"
  },
  "author": "Evan Massi",
  "license": "MIT"
}
