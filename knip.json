{
  "ignoreBinaries": ["wsl"],
  "workspaces": {
    "client": {
      "entry": ["src/main.tsx", "src/**/*.test.{ts,tsx}", "src/test/**/*.{ts,tsx}"],
      "project": "src/**/*.{ts,tsx}"
    },
    "server": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "src/**/__tests__/**/*.ts"],
      "project": "src/**/*.ts"
    },
    "packages/shared-schemas": {
      "entry": ["src/index.ts"],
      "project": "src/**/*.ts"
    }
  }
}
