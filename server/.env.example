# Odysseus Server Environment Variables
# Copy this file to .env.development or .env.production and update values

# =============================================================================
# REQUIRED - These must be set for the server to function
# =============================================================================

# Database connection string (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/odysseus_dev

# JWT secret for signing tokens (use a strong random string in production)
# Must be at least 32 characters
JWT_SECRET=your-secret-key-at-least-32-characters

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Environment mode: development | production
NODE_ENV=development

# Server port (default: 3001)
PORT=3001

# Server host/bind address (default: localhost)
HOST=localhost

# CORS allowed origins (comma-separated, default: localhost:3000,localhost:5173)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# DATABASE
# =============================================================================

# Maximum database connections in pool (default: 10)
DATABASE_MAX_CONNECTIONS=10

# =============================================================================
# JWT CONFIGURATION
# =============================================================================

# Token expiration time (default: 24h)
# Formats: '24h', '7d', '1h', etc.
JWT_EXPIRATION=24h

# Token issuer identifier (default: odysseus-api)
JWT_ISSUER=odysseus-api

# Token audience identifier (default: odysseus-client)
JWT_AUDIENCE=odysseus-client

# Signing algorithm (default: HS256)
# Options: HS256, HS384, HS512
JWT_ALGORITHM=HS256

# =============================================================================
# LOGGING
# =============================================================================

# Log level: error | warn | info | http | verbose | debug | silly (default: info)
LOG_LEVEL=info

# Enable console logging (default: true)
LOG_CONSOLE=true

# Enable file logging (default: false)
LOG_FILE=false

# =============================================================================
# EMAIL / VERIFICATION URLS
# =============================================================================

# Base URL for email verification links
VERIFICATION_BASE_URL=http://localhost:3000/verify-email

# Base URL for password reset links
RESET_PASSWORD_BASE_URL=http://localhost:3000/reset-password

# =============================================================================
# SYSTEM ADMIN
# =============================================================================

# Secret key for initial system admin account setup (one-time use)
SYSTEM_ADMIN_SETUP_KEY=

# ELECTRON (only needed when running as desktop app)
# =============================================================================

# Set to 'true' when running inside Electron
ELECTRON_APP=false
