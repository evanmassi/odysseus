{
  "name": "odysseus-server",
  "version": "2.0.0",
  "description": "Backend server for Odysseus",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias && npm run copy-shared-schemas",
    "copy-shared-schemas": "powershell -Command \"if (-not (Test-Path 'dist\\node_modules\\@odysseus\\shared-schemas\\dist')) { New-Item -ItemType Directory -Path 'dist\\node_modules\\@odysseus\\shared-schemas\\dist' -Force }; Copy-Item -Path '..\\packages\\shared-schemas\\dist\\*' -Destination 'dist\\node_modules\\@odysseus\\shared-schemas\\dist\\' -Force; Copy-Item -Path '..\\packages\\shared-schemas\\package.json' -Destination 'dist\\node_modules\\@odysseus\\shared-schemas\\' -Force\"",
    "start": "node dist/index.js",
    "package": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@odysseus/shared-schemas": "*",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.7",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.4",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  }
}
