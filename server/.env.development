# 127.0.0.1, not localhost: Node tries ::1 first, and Docker's WSL relay on ::1:5432 can hang until timeout.
DATABASE_URL=postgresql://postgres:devpassword@127.0.0.1:5432/odysseus_dev
PORT=3001
NODE_ENV=development
JWT_SECRET=dev-secret-not-for-production-32chars

# Enables the demo sign-in button. Unset it to hide the button and 404 the endpoint.
DEMO_USERNAME=ath.ena
