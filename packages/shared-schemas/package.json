{
  "name": "@odysseus/shared-schemas",
  "version": "3.0.1",
  "description": "Shared Zod schemas for Odysseus client and server",
  "private": true,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts --report-unused-disable-directives",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "peerDependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "tsup": "^8.5.0",
    "typescript": "^5.2.2"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "zod",
    "validation",
    "schemas",
    "odysseus"
  ],
  "author": "Evan Massi",
  "license": "AGPL-3.0-only"
}
